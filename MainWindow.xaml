<Window x:Class="SmallDatabaseApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="People Database" Height="760" Width="950"
        MinHeight="760" MinWidth="950" MaxHeight="760" MaxWidth="950"
        WindowStartupLocation="CenterScreen">
    <DockPanel Margin="30">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="People" FontSize="34" FontWeight="Bold" Margin="0,0,0,4" />
            <TextBlock Text="Select a person to edit their details. Save to keep your changes."
                       FontSize="16" Margin="0,0,0,18" />
            <Label Content="_Search" Target="SearchTextBox" Padding="4,0" />
            <TextBox x:Name="SearchTextBox" Height="36" TabIndex="0" Margin="0,4,0,14"
                     TextChanged="SearchTextBox_TextChanged" ToolTip="Search by first or last name" />
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Sort by _Name" Width="134" Click="SortByNameButton_Click" TabIndex="1" />
                <Button Grid.Column="1" Content="Sort by _Age" Width="134" Click="SortByAgeButton_Click" TabIndex="2" />
                <TextBlock x:Name="SortStatusText" Grid.Column="2" Text="Sorted by last name, then first name"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,4,0" />
            </Grid>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button Content="_Add Person" Width="134" Click="AddButton_Click" TabIndex="6" />
                <Button Content="_Delete Person" Width="134" Click="DeleteButton_Click" TabIndex="7" />
                <Button Content="_Save Changes" Width="134" Click="SaveButton_Click" TabIndex="8" IsDefault="True" />
            </StackPanel>
            <TextBlock Text="Click Save Changes to store additions, edits, and deletions in SQLite."
                       Margin="0,8,0,0" />
        </StackPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="PeopleDataGrid" Grid.Row="0" Margin="0,0,0,14"
                      ItemsSource="{Binding People}" SelectedItem="{Binding SelectedPerson, Mode=TwoWay}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                      SelectionMode="Single" SelectionUnit="FullRow" TabIndex="3">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="*" />
                    <DataGridTextColumn Header="Last Name" Binding="{Binding LastName}" Width="*" />
                    <DataGridTextColumn Header="Age" Binding="{Binding Age}" Width="120" />
                </DataGrid.Columns>
            </DataGrid>

            <GroupBox Grid.Row="1" Header="Selected Person" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="120" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="_First Name" Target="FirstNameTextBox" />
                    <TextBox x:Name="FirstNameTextBox" Grid.Column="0" Margin="4,26,8,4" TabIndex="4"
                             Text="{Binding SelectedPerson.FirstName, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="1" Content="_Last Name" Target="LastNameTextBox" />
                    <TextBox x:Name="LastNameTextBox" Grid.Column="1" Margin="4,26,8,4" TabIndex="5"
                             Text="{Binding SelectedPerson.LastName, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Grid.Column="2" Content="A_ge" Target="AgeTextBox" />
                    <TextBox x:Name="AgeTextBox" Grid.Column="2" Margin="4,26,4,4" TabIndex="9"
                             Text="{Binding SelectedPerson.Age, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
